#!/bin/sh

# Trigger the shared version-aware deployment helper. The helper starts the
# already-installed elevated Windows Task Scheduler job only when HEAD changed.

repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$repo_root" ]; then
  echo "[post-commit] Unable to resolve the repository root; skipping IIS deployment." >&2
  exit 0
fi

deploy_trigger="$repo_root/scripts/deployment/Trigger-LocalhostDeployIfRevisionChanged.ps1"
if [ ! -f "$deploy_trigger" ]; then
  echo "[post-commit] Version-aware deployment trigger not found: $deploy_trigger" >&2
  exit 0
fi

if ! command -v pwsh >/dev/null 2>&1; then
  echo "[post-commit] PowerShell 7 (pwsh) was not found; skipping IIS deployment." >&2
  exit 0
fi

echo "[post-commit] Checking whether the current HEAD requires an IIS deployment..."
if ! pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$deploy_trigger" -RepositoryRoot "$repo_root" -EventName "post-commit"; then
  echo "[post-commit] Could not evaluate the IIS deployment trigger. The commit was kept." >&2
  exit 0
fi

exit 0
